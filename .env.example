# ============================================================================
#  On-Demand Gatekeeper - configuration
#
#  One instance per target webapp. All values are read from the environment.
#  Copy to .env and edit, or pass as container env.
#  ASCII only.
# ============================================================================

# --- listener ---------------------------------------------------------------
# Port the gatekeeper binds (the public port clients visit).
PUBLIC_PORT=8023

# --- target webapp ----------------------------------------------------------
# Human-readable name (used in logs / status JSON).
TARGET_NAME=gazi-portfolio

# Absolute path to the target's docker-compose.yml (read-only).
TARGET_COMPOSE_FILE=C:/Users/ciphe/Documents/GitHub/gazi-portfolio/deploy/docker-compose.yml

# Absolute path to the target's .env file (read-only).
TARGET_ENV_FILE=C:/Users/ciphe/Documents/GitHub/gazi-portfolio/deploy/.env

# Host port the FULL stack binds while it is up. Must differ from PUBLIC_PORT.
# The gatekeeper overrides WEB_PORT in the target compose via process env, so
# the target's own .env (WEB_PORT=8023) is never modified.
INTERNAL_PORT=8024

# Health URL polled during warm-up. Must return 200 when the app + DB are ready.
TARGET_HEALTH_URL=http://127.0.0.1:8024/api/health

# --- timing -----------------------------------------------------------------
# Idle timeout before tearing the full stack down (ms). Default 5 hours.
IDLE_TIMEOUT_MS=18000000

# How long to wait for the full stack to become healthy (ms).
DEPLOY_TIMEOUT_MS=300000

# Poll interval while waiting for health (ms).
READY_POLL_INTERVAL_MS=2000

# Estimated deploy duration shown on the countdown page (seconds).
ESTIMATED_DEPLOY_SECONDS=90

# --- behaviour --------------------------------------------------------------
# Set to "true" to run `docker compose ... up -d --build` on first request.
# Requires the target repo context to be reachable. Default false (pre-built
# images; build once with the target's own deploy script before enabling).
DEPLOY_BUILD=false

# Optional admin token. When set, POST /_ondemand/deploy and /_ondemand/teardown
# require header `X-Admin-Token: <token>` (or ?token=). When empty, the
# endpoints are open (convenient for local dev; set it on the VPS).
ADMIN_TOKEN=
